{
  "name": "dolgoletie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/sanitize-standalone.cjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint app components lib middleware.ts next.config.ts tests e2e types",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "test": "node scripts/run-tests.cjs",
    "typecheck": "tsc --noEmit",
    "desktop:prepare": "node desktop/prepare.cjs",
    "desktop:dev": "npm run build && npm run desktop:prepare && electron desktop/main.cjs",
    "desktop:pack": "npm run build && npm run desktop:prepare && electron-builder --config desktop/electron-builder.cjs --dir",
    "desktop:dist": "npm run build && npm run desktop:prepare && electron-builder --config desktop/electron-builder.cjs"
  },
  "dependencies": {
    "@heroui/react": "^3.2.5",
    "@heroui/styles": "^3.2.5",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.1.0",
    "@prisma/driver-adapter-utils": "^6.19.3",
    "@react-aria/interactions": "^3.28.1",
    "@reduxjs/toolkit": "^2.5.0",
    "@types/pdfkit": "^0.13.9",
    "archiver": "^7.0.1",
    "argon2": "^0.45.1",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "clsx": "^2.1.1",
    "electron": "^44.7.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "file-type": "^22.1.1",
    "framer-motion": "^11.15.0",
    "iron-session": "^8.0.4",
    "next": "^15.1.4",
    "pdfkit": "^0.15.2",
    "pino": "^9.5.0",
    "react": "^19.0.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-redux": "^9.2.0",
    "react-stately": "^3.50.0",
    "sharp": "^0.35.5",
    "unzipper": "^0.12.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/unzipper": "^0.10.10",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
